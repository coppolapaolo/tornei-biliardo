<div class="c7-app">

  <aside class="c7-side">
    <div class="c7-side__top">
      <span class="c7-side__brand">
        <span class="c7-side__mark"><svg viewBox="0 0 24 24" class="ico"><use href="#i-nodes"></use></svg></span>
        <span>
          <span class="c7-side__name">Tornei Biliardo</span>
          <span class="c7-side__role">giocatore</span>
        </span>
      </span>
      <span class="c7-sidetoggle"><svg viewBox="0 0 24 24" class="ico ico-sm"><use href="#i-collapse"></use></svg></span>
    </div>

    <nav class="c7-side__group">
      <span class="c7-side__grouplabel">Generale</span>
      <a href="#" class="is-active"><svg viewBox="0 0 24 24" class="ico"><use href="#i-gauge"></use></svg>Dashboard</a>
      <a href="#"><svg viewBox="0 0 24 24" class="ico"><use href="#i-venue"></use></svg>Sale Biliardo</a>
      <a href="#"><svg viewBox="0 0 24 24" class="ico"><use href="#i-target"></use></svg>Esercizi</a>
      <a href="#"><svg viewBox="0 0 24 24" class="ico"><use href="#i-users"></use></svg>Sfide individuali</a>
      <a href="#"><svg viewBox="0 0 24 24" class="ico"><use href="#i-help"></use></svg>Guida</a>
      <a href="#"><svg viewBox="0 0 24 24" class="ico"><use href="#i-megaphone"></use></svg>Segnalazioni</a>
    </nav>

    <div class="c7-side__user">
      <span class="c7-avatar">MA</span>
      <span class="fill">
        <span style="display:block;font-size:12px;font-weight:800">marco</span>
        <span class="c7-side__role">giocatore &middot; Lv 7</span>
      </span>
      <span class="c7-side__count">3</span>
    </div>
  </aside>

  <div class="c7-main">

    <header class="c7-head">
      <div class="c7-head__title">
        <span class="c7-title">Dashboard Giocatore</span>
      </div>
      <span class="gami-badge">
        <span class="gami-badge__ring"><svg viewBox="0 0 24 24" class="ico ico-sm"><use href="#i-trophy"></use></svg></span>
        <span class="gami-badge__level">Lv 7</span>
        <span class="gami-badge__xp">340 XP</span>
      </span>
    </header>

    <main class="c7-content">

      <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:22px">
        <div class="fill">
          <div class="c7-kicker">Giocatore</div>
          <h1 style="margin-top:4px;font-size:24px">Ciao marco</h1>
        </div>
        <span class="btn btn-secondary btn-sm btn-secondary--onpage">
          <svg viewBox="0 0 24 24" class="ico ico-sm"><use href="#i-plus"></use></svg>Crea Match
        </span>
      </div>

      <section class="c7-feedback">
        <div class="c7-feedback__head">
          <h2>Come stai andando</h2>
          <span class="c7-feedback__badge c7-feedback__badge--positive">14 attività nel mese</span>
        </div>

        <div class="split" style="align-items:start;margin-top:4px">
          <div>
            <div class="c7-feedback__metrics">
              <div>
                <div class="c7-feedback__value">1284</div>
                <div class="c7-feedback__label">Elo</div>
                <div class="c7-feedback__delta c7-feedback__delta--up">+18 in 6</div>
              </div>
              <div>
                <div class="c7-feedback__value">0.61</div>
                <div class="c7-feedback__label">TPA di carriera</div>
                <div class="c7-feedback__delta c7-feedback__delta--up">+0.04</div>
              </div>
            </div>

            <div class="c7-feedback__strip">
              <div class="c7-feedback__striphead">
                <span>Le tue ultime partite</span>
                <span class="c7-feedback__stripnote">dalla più vecchia</span>
              </div>
              <div class="c7-feedback__tiles">
                <span class="c7-feedback__tile c7-feedback__tile--win">5&ndash;3</span>
                <span class="c7-feedback__tile c7-feedback__tile--loss">3&ndash;5</span>
                <span class="c7-feedback__tile c7-feedback__tile--win">5&ndash;2</span>
                <span class="c7-feedback__tile c7-feedback__tile--win">5&ndash;4</span>
                <span class="c7-feedback__tile c7-feedback__tile--draw">4&ndash;4</span>
                <span class="c7-feedback__tile c7-feedback__tile--win">5&ndash;1</span>
              </div>
            </div>
          </div>

          <div class="c7-feedback__chart" style="margin-top:0">
            <svg class="c7-feedback__spark" viewBox="0 0 130 34" preserveAspectRatio="none" role="img" aria-label="1266 all'inizio, oggi 1284">
              <polyline points="2,34 2,26 20,24 38,27 56,20 74,17 92,19 110,12 128,9 128,34" fill="rgba(44,74,82,.10)" stroke="none"></polyline>
              <polyline points="2,29 20,28 38,26 56,25 74,23 92,22 110,20 128,18" fill="none" stroke="var(--c7-chart-ink)" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" vector-effect="non-scaling-stroke"></polyline>
              <polyline points="2,26 20,24 38,27 56,20 74,17 92,19 110,12 128,9" fill="none" stroke="var(--c7-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></polyline>
              <line x1="56" y1="20" x2="56" y2="20" stroke="var(--c7-chart-ink)" stroke-width="5" stroke-linecap="round" vector-effect="non-scaling-stroke"></line>
              <line x1="128" y1="9" x2="128" y2="9" stroke="var(--c7-ok)" stroke-width="7" stroke-linecap="round" vector-effect="non-scaling-stroke"></line>
            </svg>
            <div class="c7-feedback__chartlegend">
              <span><span class="c7-feedback__linekey"></span>Elo</span>
              <span><span class="c7-feedback__linekey c7-feedback__linekey--dash"></span>TPA</span>
            </div>
            <div class="c7-feedback__caption"><span>1266 all'inizio</span><span>oggi</span></div>
          </div>
        </div>
      </section>

      <section class="sec">
        <div class="sec-head"><h2>I tuoi match</h2></div>
        <div class="cards">
          <article class="c7-card cardstack">
            <div class="rowtop">
              <div class="fill">
                <div class="c7-kicker">Turno 3</div>
                <div class="cardtitle" style="margin-top:4px">Gara 3 &mdash; Palla 8</div>
                <div class="meta">Campionato Sociale 2026</div>
              </div>
              <span class="c7-state c7-state--err">In corso</span>
            </div>
            <div style="font-size:14px;font-weight:700">vs Luca Berti</div>
            <div class="c7-num" style="font-size:22px">3 &mdash; 2</div>
            <div class="meta">
              Palla 8 <span class="c7-sep">&middot;</span> Al <span class="c7-num">5</span><br>
              Tavolo <span class="c7-num">4</span>
            </div>
            <span class="btn btn-primary btn-sm btn-w">
              <svg viewBox="0 0 24 24" class="ico ico-sm"><use href="#i-play"></use></svg>Gioca
            </span>
          </article>
        </div>
      </section>

      <section class="sec">
        <div class="sec-head">
          <h2>Gare <span class="count">2 attive</span></h2>
          <a href="#" style="font-size:12px">Vedi tutte</a>
        </div>
        <div class="cards">
          <article class="c7-card cardstack">
            <div class="rowtop">
              <div class="fill">
                <div class="cardtitle">Gara 3 &mdash; Palla 8</div>
                <div class="meta">Campionato Sociale 2026</div>
                <div class="meta" style="margin-top:4px">Palla 8 <span class="c7-sep">&middot;</span> Al <span class="c7-num">5</span></div>
              </div>
              <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px">
                <span class="c7-state c7-state--accent">Iscritto</span>
                <span class="c7-state c7-state--err">In corso</span>
              </div>
            </div>
            <div class="meta">
              <span class="c7-num" style="color:var(--c7-ink)">30/08/2026</span><br>
              Biliardo Club Udine
            </div>
            <div class="row" style="font-size:12px;font-weight:700">
              <span class="fill">Turno <span class="c7-num">3/5</span></span>
              <span class="muted"><span class="c7-num">14</span> giocatori</span>
            </div>
            <div style="display:flex;gap:8px">
              <span class="btn btn-secondary btn-sm btn-fill">Dettagli</span>
              <span class="btn btn-primary btn-sm btn-fill">
                <svg viewBox="0 0 24 24" class="ico ico-sm"><use href="#i-play"></use></svg>Turno 3
              </span>
            </div>
          </article>

          <article class="c7-card cardstack">
            <div class="rowtop">
              <div class="fill">
                <div class="cardtitle">Gara 4 &mdash; Palla 9</div>
                <div class="meta">Campionato Sociale 2026</div>
                <div class="meta" style="margin-top:4px">Palla 9 <span class="c7-sep">&middot;</span> Al <span class="c7-num">4</span></div>
              </div>
              <span class="c7-state c7-state--ok">Iscrizioni aperte</span>
            </div>
            <div class="meta">
              <span class="c7-num" style="color:var(--c7-ink)">12/09/2026</span><br>
              Biliardo Club Udine<br>
              <span style="color:var(--c7-warn)">Scade: <span class="c7-num">10/09/2026 20:00</span></span>
            </div>
            <div class="row" style="font-size:12px;font-weight:700">
              <span class="fill muted">Quota <span class="c7-num">&euro;10,00</span></span>
              <span class="muted"><span class="c7-num">18/24</span></span>
            </div>
            <div style="display:flex;gap:8px">
              <span class="btn btn-secondary btn-sm btn-fill">Dettagli</span>
              <span class="btn btn-success btn-sm btn-fill">Iscriviti</span>
            </div>
          </article>

          <article class="c7-card cardstack">
            <div class="rowtop">
              <div class="fill">
                <div class="cardtitle">Torneo del Giovedì</div>
                <div class="meta">Gara singola</div>
                <div class="meta" style="margin-top:4px">Palla 8 <span class="c7-sep">&middot;</span> Al <span class="c7-num">5</span></div>
              </div>
              <span class="c7-state c7-state--warn">Massimo raggiunto</span>
            </div>
            <div class="meta">
              <span class="c7-num" style="color:var(--c7-ink)">04/09/2026</span><br>
              Sala Da Vinci, Pordenone
            </div>
            <div class="row" style="font-size:12px;font-weight:700">
              <span class="fill muted">Gratuita</span>
              <span class="muted"><span class="c7-num">24/24</span> <span style="color:var(--c7-warn)">+3</span></span>
            </div>
            <div style="display:flex;gap:8px">
              <span class="btn btn-secondary btn-sm btn-fill">Dettagli</span>
              <span class="btn btn-warning btn-sm btn-fill">Lista d'attesa</span>
            </div>
          </article>
        </div>
      </section>

      <section class="sec">
        <div class="sec-head">
          <h2>Campionati <span class="count">1 attivo</span></h2>
          <a href="#" style="font-size:12px">Vedi tutti</a>
        </div>
        <div class="cards">
          <article class="c7-card cardstack">
            <div class="rowtop">
              <div class="fill">
                <div class="cardtitle">Campionato Sociale 2026</div>
                <div class="meta">amalfi <span class="c7-sep">&middot;</span> 5 gare</div>
              </div>
              <span class="c7-state c7-state--err">In corso</span>
            </div>
            <div class="meta">Prossima: <span class="c7-num" style="color:var(--c7-ink)">12/09/2026</span></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <span class="c7-state c7-state--info">Senza X</span>
              <span class="c7-state c7-state--ok">Playoff</span>
            </div>
            <span class="btn btn-secondary btn-sm btn-w">Dettagli</span>
          </article>
        </div>
      </section>

    </main>
  </div>
</div>
