# .gitignore
# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
coverage.json
*.cover
.hypothesis/
.pytest_cache/

# Virtual environments
env/
venv/
ENV/
env.bak/
venv.bak/

# Database
*.db
*.sqlite
*.sqlite3
instance/
db_snapshots/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.VSCodeCounter/
.qoder/

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node (frontend headless tests — tests/frontend)
node_modules/
package-lock.json

# Flask
instance/
.env
.envrc

# PythonAnywhere specific
.bash_history
.python_history

# Claude Code — track settings + custom skills, ignore plugin-installed
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/session-start.sh
!.claude/skills/
.claude/skills/*
!.claude/skills/adr/
!.claude/skills/interview/
!.claude/skills/regression-guard/
!.claude/skills/translate/
!.claude/skills/ui-conventions/
!.claude/skills/ui-7c/
!.claude/skills/help-docs/
!.claude/skills/deploy/
.agent/
.codegraph/
_bmad/
_bmad-output/*
!_bmad-output/project-context.md
!_bmad-output/implementation-artifacts/
!_bmad-output/planning-artifacts/
messages.mo


---
export_script.py
repository_export_*.md
export_zip_md.py
repository_export_*.zip
export_repo.py
repository_export_*/
static/uploads/
# Stato locale del controllo sulla guida /aiuto (.claude/hooks/check-help-docs.sh):
# dice "questo lavoro l'ho gia' esaminato" su questa macchina, non e' contenuto
# del repository e non ha senso condividerlo.
.claude/.help-docs-checked
.claude/.help-docs-pending
# Grafo di conoscenza generato dalla skill graphify: artefatto locale e
# rigenerabile (graph.json da solo pesa ~10 MB), non contenuto del repository.
graphify-out/
